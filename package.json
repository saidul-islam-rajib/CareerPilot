{
  "name": "careerpilot",
  "private": true,
  "version": "1.0.0",
  "description": "CareerPilot monorepo: mobile, web, admin apps and shared packages. Developed by Team Sober (https://team-sober.com/).",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "mobile": "pnpm --filter @careerpilot/mobile start",
    "mobile:demo": "pnpm --filter @careerpilot/mobile start:demo",
    "mobile:web": "pnpm --filter @careerpilot/mobile web",
    "phone": "node scripts/dev/phone.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
