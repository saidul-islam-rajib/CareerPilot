{
  "name": "@careerpilot/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@careerpilot/api-client": "workspace:*",
    "@careerpilot/brand": "workspace:*",
    "@careerpilot/client-core": "workspace:*",
    "@careerpilot/domain-ui-logic": "workspace:*",
    "@careerpilot/dynamic-forms": "workspace:*",
    "@careerpilot/i18n": "workspace:*",
    "@careerpilot/ui-tokens": "workspace:*",
    "@careerpilot/validation": "workspace:*",
    "@expo/ui": "~58.0.23",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "js-yaml": "^4.3.2",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node ../../scripts/dev/phone.mjs",
    "start:demo": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit -p .",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|@careerpilot/.*|react-native-reanimated|react-native-worklets|standard-navigation))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/**/*.spec.{ts,tsx}",
      "!src/test/**"
    ],
    "forceExit": true,
    "testTimeout": 20000
  }
}
