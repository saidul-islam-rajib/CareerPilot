{
	email {$CAREERPILOT_ACME_EMAIL}
	acme_ca {$CAREERPILOT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	servers {
		protocols h1 h2
	}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(api_site) {
	import secure_headers
	encode zstd gzip
	request_body {
		max_size {$CAREERPILOT_MAX_UPLOAD:25MB}
	}
	@api_docs path /docs /docs/* /redoc /redoc/* /openapi.json
	respond @api_docs 404
}

{$CAREERPILOT_SITE_PREFIX}app.{$CAREERPILOT_DOMAIN} {
	import secure_headers
	encode zstd gzip
	reverse_proxy web:3000
}

{$CAREERPILOT_SITE_PREFIX}admin.{$CAREERPILOT_DOMAIN} {
	import secure_headers
	encode zstd gzip
	reverse_proxy admin:3001
}

{$CAREERPILOT_SITE_PREFIX}api.{$CAREERPILOT_DOMAIN} {
	import api_site
	reverse_proxy user-api:8000
}

{$CAREERPILOT_SITE_PREFIX}admin-api.{$CAREERPILOT_DOMAIN} {
	import api_site
	reverse_proxy admin-api:8001
}

{$CAREERPILOT_SITE_PREFIX}m.{$CAREERPILOT_DOMAIN} {
	import secure_headers
	encode zstd gzip
	root * /srv/mobile
	@hashed path /_expo/* /assets/*
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
